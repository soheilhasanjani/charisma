{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/mocks/browser.ts",
    "src/features/options/risk/risk.worker.ts",
    "src/test/**/*.ts",
    "**/*.test.{ts,tsx}",
    "scripts/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs"],
  "ignore": ["src/mocks/**", "src/components/primitives/**"],
  "ignoreDependencies": [
    "@fontsource-variable/vazirmatn",
    "tailwindcss",
    "tw-animate-css",
    "shadcn"
  ],
  "ignoreExportsUsedInFile": true
}
