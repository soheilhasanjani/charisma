# Origin for REST calls. Leave empty to use the current host.
VITE_API_BASE_URL=

# Set to "true" in development to enable MSW mock API + WebSocket (see src/main.tsx).
VITE_ENABLE_MOCKS=

# Market feed WebSocket. Leave empty to use ws://localhost/ws/options, which is the
# address the MSW mock registers. MSW matches the full URL, so the port must not be
# added when running against the mock.
VITE_WS_URL=
